      "title": "Solver",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "qaoa": {
      "anyOf": [
        {
          "$ref": "#/$defs/QaoaOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
