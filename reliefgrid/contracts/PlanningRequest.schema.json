{
  "$defs": {
    "QaoaOptions": {
      "additionalProperties": false,
      "properties": {
        "layers": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Layers",
          "type": "integer"
        },
        "shots": {
          "default": 512,
          "maximum": 8192,
          "minimum": 1,
          "title": "Shots",
          "type": "integer"
        },
        "maxEvaluations": {
          "default": 40,
          "maximum": 300,
          "minimum": 1,
          "title": "Maxevaluations",
          "type": "integer"
        },
        "starts": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Starts",
          "type": "integer"
        },
        "phaseScale": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Phasescale",
          "type": "number"
        },
        "warmStartGreedy": {
          "default": false,
          "title": "Warmstartgreedy",
          "type": "boolean"
        }
      },
      "title": "QaoaOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenarioId": {
      "title": "Scenarioid",
      "type": "string"
    },
    "scenarioRevision": {
      "title": "Scenariorevision",
      "type": "string"
    },
    "closedEdgeIds": {
      "default": [],
      "items": {
        "type": "string"
      },
